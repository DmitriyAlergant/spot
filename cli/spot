#!/bin/sh
# spot — deploy static sites to the Spot platform.
# Edit this source copy, then run `just generate` to refresh the served
# sdk/spot copy and the Go-embedded server/static_assets/sdk/spot copy.
#
# Deploys go through the platform's deploy API (the same endpoint the
# apex web deployer uses), so the only configuration is where the
# platform lives. Via environment (or $XDG_CONFIG_HOME/spot/env,
# default ~/.config/spot/env, sourced if present):
#   SPOT_URL   apex URL of the Spot deployment
#              (default http://spot.localhost:8080)
set -eu

# Read SPOT_URL from the config without executing the file: parse it as
# KEY=VALUE and accept only the SPOT_URL key, so a hostile value cannot
# run as shell. An env-provided SPOT_URL takes precedence.
spot_config="${XDG_CONFIG_HOME:-$HOME/.config}/spot/env"
if [ -z "${SPOT_URL:-}" ] && [ -f "$spot_config" ]; then
    while IFS='=' read -r key value; do
        [ "$key" = SPOT_URL ] && SPOT_URL=$value
    done < "$spot_config"
fi

SPOT_URL=${SPOT_URL:-http://spot.localhost:8080}
SPOT_URL=${SPOT_URL%/}
SPOT_SCHEME=${SPOT_URL%%://*}
SPOT_HOSTPORT=${SPOT_URL#*://}
SPOT_DOMAIN=${SPOT_HOSTPORT%%:*}

# Local HTTPS dev may use a private CA; localhost is trusted implicitly.
case $SPOT_DOMAIN in
    localhost|*.localhost) SPOT_CURL_OPTS=-k ;;
    *) SPOT_CURL_OPTS= ;;
esac

banner() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        esc=$(printf '\033')
        pink="${esc}[38;5;205m"
        violet="${esc}[38;5;99m"
        mint="${esc}[38;5;48m"
        reset="${esc}[0m"
        printf '%s\n' \
            "${pink}"'   _____             __'"${reset}" \
            "${pink}"'  / ___/____  ____  / /_'"${reset}" \
            "${violet}"'  \__ \/ __ \/ __ \/ __/'"${reset}" \
            "${violet}"' ___/ / /_/ / /_/ / /_'"${reset}" \
            "${mint}"'/____/ .___/\____/\__/'"${reset}" \
            "${mint}"'    /_/'"${reset}" \
            "${violet}"'  Drop a folder, get a spot.'"${reset}" \
            ""
    else
        cat <<'EOF'
   _____             __
  / ___/____  ____  / /_
  \__ \/ __ \/ __ \/ __/
 ___/ / /_/ / /_/ / /_
/____/ .___/\____/\__/
    /_/
  Drop a folder, get a spot.

EOF
    fi
}

usage() {
    banner
    cat <<'EOF'
usage: spot <command>

commands:
  deploy [--screenshot] [name] [path]
                        sync a directory or index.html (default .) to
                        the site <name> (default: current directory name)
  show init [json]      write a starter Spot Show JSON file
  show build [json] [out]
                        render a card/block show.json into a static site
  show deploy [--open] [--no-screenshot] <name> [json]
                        render show.json and deploy it to <name>
  show watch [--open] [--no-screenshot] <name> [json]
                        redeploy whenever show.json changes
  agent-howto           print current Spot instructions for agents
  show-schema           print the Spot Show JSON schema guide
  init [options]        write the Spot agent skill for Claude, Codex, or Pi
  update                replace this CLI with the latest from SPOT_URL

init options:
  --agent <list>        comma-separated agents: claude,codex,pi
  --all-agents          install for every supported agent
  --scope <scope>       project or user
  --yes, -y             accept detected defaults without prompting
  --force               overwrite existing skill files
  --dry-run             print target files without writing
EOF
    exit 1
}

find_chrome() {
    if [ -n "${SPOT_CHROME:-}" ]; then
        if command -v "$SPOT_CHROME" >/dev/null 2>&1 || [ -x "$SPOT_CHROME" ]; then
            printf '%s\n' "$SPOT_CHROME"
            return 0
        fi
        echo "error: SPOT_CHROME does not point to an executable: $SPOT_CHROME" >&2
        return 1
    fi
    for chrome in chromium chromium-browser google-chrome google-chrome-stable; do
        if command -v "$chrome" >/dev/null 2>&1; then
            command -v "$chrome"
            return 0
        fi
    done
    echo "error: Chromium or Google Chrome is required for screenshots" >&2
    echo "       install chromium, set SPOT_CHROME, or pass --no-screenshot" >&2
    return 1
}

capture_screenshot() {
    url=$1
    out=$2
    chrome=$(find_chrome) || exit 1
    profile=$(mktemp -d "${TMPDIR:-/tmp}/spot-chrome.XXXXXX")
    echo "capturing screenshot: $url"
    if ! HOME=${HOME:-/tmp} XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-/tmp/.config} "$chrome" \
        --headless=new \
        --disable-gpu \
        --disable-dev-shm-usage \
        --disable-crash-reporter \
        --disable-crashpad \
        --no-first-run \
        --no-default-browser-check \
        --no-sandbox \
        --hide-scrollbars \
        --ignore-certificate-errors \
        --run-all-compositor-stages-before-draw \
        --user-data-dir="$profile" \
        --window-size=1280,800 \
        --screenshot="$out" \
        "$url" >/dev/null 2>&1; then
        rm -rf "$profile"
        echo "error: screenshot capture failed with $(basename "$chrome")" >&2
        exit 1
    fi
    rm -rf "$profile"
    [ -s "$out" ] || { echo "error: screenshot capture wrote an empty file" >&2; exit 1; }
}

deploy_upload() {
    name=$1
    src=$2
    preserve_access=$3
    screenshot=${4:-}

    if [ -f "$src" ]; then
        file=$(basename "$src")
        dir=$(dirname "$src")
    else
        dir=$src
    fi

    # One -F part per file, the filename carrying the site-relative path
    # — the shape /api/deploy expects. The server syncs: files absent
    # from the upload are removed from the live site. Dot directories
    # (.git and friends) stay home; the server drops them anyway.
    #
    # Quote the path and filename= values so curl does not treat ';' ','
    # or '@' in a filename as -F metacharacters.
    set -- -F "site=$name"
    if [ "$preserve_access" = 1 ]; then
        set -- "$@" -F "preserve_access=true"
    fi
    if [ -f "$src" ]; then
        set -- "$@" -F "files=@\"$file\";filename=\"index.html\""
    else
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            f=${f#./}
            set -- "$@" -F "files=@\"$f\";filename=\"$f\""
        done <<EOF
$(cd "$dir" && find . -name '.?*' -prune -o -type f -print)
EOF
    fi
    if [ -n "$screenshot" ]; then
        set -- "$@" -F "files=@\"$screenshot\";filename=\"_screenshot.png\""
    fi

    # Capture curl's exit without tripping set -e, so a network/HTTP
    # failure reaches the friendly message below instead of aborting.
    if ! out=$(cd "$dir" && curl -sS $SPOT_CURL_OPTS -w '\n%{http_code}' \
        "$@" "$SPOT_URL/api/deploy"); then
        echo "error: could not reach $SPOT_URL/api/deploy" >&2
        exit 1
    fi
    status=$(printf '%s' "$out" | tail -n 1)
    body=$(printf '%s' "$out" | sed '$d')
    if [ "$status" != "200" ]; then
        echo "error: deploy failed (HTTP $status): $body" >&2
        exit 1
    fi
}

deploy() {
    deploy_screenshot=0
    preserve_access=0
    while [ $# -gt 0 ]; do
        case $1 in
            --screenshot) deploy_screenshot=1; shift ;;
            --no-screenshot) deploy_screenshot=0; shift ;;
            --preserve-access) preserve_access=1; shift ;;
            --help|-h) usage ;;
            -*) echo "error: unknown deploy option '$1'" >&2; exit 1 ;;
            *) break ;;
        esac
    done
    name=${1:-$(basename "$PWD")}
    src=${2:-.}
    if [ "$#" -eq 1 ] && [ -f "$1" ] && [ "$(basename "$1")" = "index.html" ]; then
        name=$(basename "$PWD")
        src=$1
    fi
    case $name in
        *[!a-z0-9-]*|'')
            echo "error: site name '$name' must match [a-z0-9-]+" >&2
            exit 1
            ;;
    esac
    if [ -f "$src" ]; then
        file=$(basename "$src")
        dir=$(dirname "$src")
        if [ "$file" != "index.html" ]; then
            echo "error: single-file deploys must be named index.html" >&2
            exit 1
        fi
    else
        dir=$src
        if [ ! -e "$dir/index.html" ]; then
            echo "error: $dir/index.html not found — a site needs at least an index.html" >&2
            exit 1
        fi
    fi
    echo "deploying $src -> $name.$SPOT_DOMAIN"

    deploy_upload "$name" "$src" "$preserve_access"
    if [ "$deploy_screenshot" = 1 ]; then
        shot=$(mktemp "${TMPDIR:-/tmp}/spot-screenshot.XXXXXX.png")
        capture_screenshot "$SPOT_SCHEME://$name.$SPOT_HOSTPORT/" "$shot"
        deploy_upload "$name" "$src" "$preserve_access" "$shot"
        rm -f "$shot"
    fi
    echo "live: $SPOT_SCHEME://$name.$SPOT_HOSTPORT/"
}

