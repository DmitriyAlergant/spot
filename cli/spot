show_meta_json() {
    file=$1
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$file" <<'PY'
import json
import sys

default_title = "Spot Show"
default_description = "A card/block visual report rendered by Spot."

try:
    with open(sys.argv[1], encoding="utf-8") as f:
        show = json.load(f)
except Exception as exc:
    print(f"error: could not parse {sys.argv[1]}: {exc}", file=sys.stderr)
    sys.exit(1)

if not isinstance(show, dict):
    show = {}
title = show.get("title") or default_title
description = show.get("description") or default_description
if not isinstance(title, str):
    title = default_title
if not isinstance(description, str):
    description = default_description
print(json.dumps({
    "title": title,
    "description": description,
    "tags": ["spot-show", "agent", "dashboard", "tools"],
}, separators=(",", ":")))
PY
        return
    fi
    printf '%s\n' '{"title":"Spot Show","description":"A card/block visual report rendered by Spot.","tags":["spot-show","agent","dashboard","tools"]}'
}

show_build() {
    spec=${1:-show.json}
    out=${2:-spot-show-out}
    [ -f "$spec" ] || { echo "error: $spec not found" >&2; exit 1; }
    case $out in
        ''|/|.) echo "error: refusing to write show output to '$out'" >&2; exit 1 ;;
    esac
    spec_dir=$(cd "$(dirname "$spec")" && pwd -P) || exit 1
    spec_abs=$spec_dir/$(basename "$spec")
    if [ -e "$out" ]; then
        if [ -d "$out" ]; then
            out_abs=$(cd "$out" && pwd -P) || exit 1
            case $spec_abs in
                "$out_abs"/*) echo "error: refusing to write show output over source '$spec'" >&2; exit 1 ;;
            esac
        else
            out_dir=$(cd "$(dirname "$out")" && pwd -P) || exit 1
            out_abs=$out_dir/$(basename "$out")
            [ "$out_abs" != "$spec_abs" ] || { echo "error: refusing to write show output over source '$spec'" >&2; exit 1; }
        fi
    fi
    rm -rf "$out" || exit 1
    mkdir -p "$out" || exit 1
    cp "$spec" "$out/show.json" || exit 1
    if ! show_meta_json "$spec" > "$out/_spot.json"; then
        exit 1
    fi
