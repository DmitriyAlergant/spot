    .shell { width:min(1160px, calc(100vw - 36px)); margin:0 auto; padding:24px 0 56px; }
    .topbar { position:sticky; top:0; z-index:10; display:flex; justify-content:flex-end; gap:10px; margin:0 calc((100vw - min(1160px, calc(100vw - 36px))) / -2); padding:12px calc((100vw - min(1160px, calc(100vw - 36px))) / 2); border-bottom:1px solid var(--line); background:color-mix(in srgb, var(--bg), transparent 8%); backdrop-filter:blur(14px); }
