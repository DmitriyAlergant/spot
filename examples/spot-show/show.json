{
  "title": "Spot Show demo",
  "description": "A card/block visual report rendered by Spot and refreshed on redeploy.",
  "updated_at": "example",
  "cards": [
    {
      "id": "overview",
      "title": "What Spot Show is",
      "summary": "Agents write this JSON instead of hand-authoring a whole page.",
      "blocks": [
        {
          "kind": "markdown",
          "title": "Summary",
          "body": "## Agent visual report\n- One site name acts like a session\n- Cards group focused ideas\n- Blocks render prose, diagrams, diffs, logs, data, and demos\n- Redeploying refreshes open browser tabs"
        },
        {
          "kind": "mermaid",
          "title": "Workflow",
          "body": "flowchart TD\n  A[Agent] --> B[show.json]\n  B --> C[spot show deploy]\n  C --> D[Spot site]\n  D --> E[Browser refresh]"
        }
      ]
    },
    {
      "id": "implementation",
      "title": "Implementation checkpoint",
      "summary": "A typical agent update combines a diff with validation output.",
      "blocks": [
        {
          "kind": "diff",
          "title": "Example patch",
          "layout": "split",
          "body": "diff --git a/app.js b/app.js\n@@\n-console.log('old')\n+console.log('new')"
        },
        {
          "kind": "terminal",
          "title": "Validation",
          "cols": 92,
          "body": "$ just test\n\u001b[32;1mok\u001b[0m  spot/server  1.8s"
        },
        {
          "kind": "code",
          "title": "renderer.js",
          "language": "js",
          "line_start": 80,
          "body": "export function render(show) {\n  return show.cards.map(renderCard);\n}"
        }
      ]
    },
    {
      "id": "status",
      "title": "Structured status",
      "compact": true,
      "blocks": [
        {
          "kind": "json",
          "title": "State",
          "value": {
            "live_reload": true,
            "same_site_updates": true,
            "supported_blocks": ["markdown", "mermaid", "diff", "terminal", "code", "json", "image", "html", "trace"]
          }
        }
      ]
    },
    {
      "id": "sandbox",
      "title": "Small custom demo",
      "compact": true,
      "blocks": [
        {
          "kind": "html",
          "title": "Sandboxed HTML",
          "body": "<style>body{min-height:180px;display:grid;place-items:center;background:var(--spot-panel-muted);color:var(--spot-text)}.box{padding:20px 24px;border:1px solid var(--spot-line);border-radius:12px;background:var(--spot-panel);box-shadow:0 14px 32px color-mix(in srgb,var(--spot-text),transparent 92%)}strong{color:var(--spot-accent)}</style><div class=box><strong>Theme-aware</strong> HTML block</div>"
        }
      ]
    },
